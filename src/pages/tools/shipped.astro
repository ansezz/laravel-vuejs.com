---
import ToolPage from '../../components/ToolPage.astro'
import { SHIPPED_ROWS, SHIPPED_SOURCES } from '../../data/dev-tools'
const lead = 'New opt-in APIs from the release articles published here, from Laravel 13.35 (October 6, 2026) to Laravel 13.38 and Laravel AI SDK 1.3 (October 20). On Inertia, install 3.9.1. QUERY also matches existing Route::any() and Route::redirect() routes. The articles also list bug fixes.'
---
<ToolPage title="What shipped" lead={lead}>
  <p class="pkg-set-note">{lead}</p>
  <div class="tool-table-wrap">
    <table class="tool-table">
      <thead>
        <tr>
          <th scope="col">Release</th>
          <th scope="col">Change</th>
          <th scope="col">Use</th>
          <th scope="col">Watch</th>
        </tr>
      </thead>
      <tbody>
        {SHIPPED_ROWS.map(row => (
          <tr>
            <th scope="row">{row.release}</th>
            <td>{row.change}</td>
            <td>{row.use}</td>
            <td>{row.watch} <a href={row.sourcePath}>Source</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="pkg-actions">
    {SHIPPED_SOURCES.map(source => <a class="btn" href={source.path}>{source.label}</a>)}
    <a class="btn" href="/tools/shipped.md">Markdown for assistants</a>
  </p>
</ToolPage>
