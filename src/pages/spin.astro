---
import ToolPage from '../components/ToolPage.astro'
import { spinIdeas } from '../data/spin'

const description = 'Run it. The reel stops on one project you can build today. Copy the prompt.'
---
<ToolPage title="Today's project" lead={description} description={description}>
  <div class="spin" id="spin" data-state="idle">
    <script is:inline>
      document.getElementById('spin')?.setAttribute('data-live', '')
    </script>
    <p class="spin-note">This page does not chat. Nothing is sent off this page. With JavaScript off, every project stays on the page with its prompt. The reel needs the script.</p>
    <div class="spin-reel" data-spin-reel>
      <div class="spin-track" data-spin-track></div>
    </div>
    <div class="spin-hud">
      <p class="kicker">One run</p>
      <p class="spin-lead">The reel keeps scrolling, then stops on one project you can build.</p>
      <p class="spin-prompt" data-spin-prompt></p>
      <p class="spin-guide"><a data-spin-link></a></p>
      <div class="spin-actions">
        <button type="button" class="btn btn-primary" data-spin-run>
          <span class="spin-run-label">Run</span>
        </button>
        <button type="button" class="copy-btn" data-copy="" disabled aria-label="Copy the prompt">
          <svg class="i-copy" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
          <svg class="i-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span class="copy-label">Copy the prompt</span>
        </button>
        <a class="spin-tools" href="/tools">Tools</a>
      </div>
    </div>
    <ul class="spin-static">
      {spinIdeas.map((item) => (
        <li>
          <h2 class="spin-static-title">{item.title}</h2>
          <p class="spin-static-prompt">{item.prompt}</p>
          <a href={item.guide}>{item.guideTitle}</a>
        </li>
      ))}
    </ul>
  </div>
  <script>
    import { nextSpin, spinIdeas } from '../data/spin'

    const root = document.querySelector<HTMLElement>('#spin')
    if (root?.dataset.live !== undefined && root.dataset.bound !== '1') {
      root.dataset.bound = '1'
      const reel = root.querySelector<HTMLElement>('[data-spin-reel]')
      const track = root.querySelector<HTMLElement>('[data-spin-track]')
      const prompt = root.querySelector<HTMLElement>('[data-spin-prompt]')
      const guide = root.querySelector<HTMLAnchorElement>('[data-spin-link]')
      const run = root.querySelector<HTMLButtonElement>('[data-spin-run]')
      const label = root.querySelector<HTMLElement>('.spin-run-label')
      const copy = root.querySelector<HTMLButtonElement>('.copy-btn')
      const key = 'lv-spin-shown'

      if (reel && track && prompt && guide && run && label && copy) {
        const readShown = (): string[] => {
          try {
            const raw = sessionStorage.getItem(key)
            const parsed: unknown = raw ? JSON.parse(raw) : []
            return Array.isArray(parsed) ? parsed.filter((id) => typeof id === 'string') : []
          } catch {
            return []
          }
        }

        let timer = 0
        let spinning = false

        const settle = (idea: (typeof spinIdeas)[number], landed: HTMLElement) => {
          if (!spinning) return
          spinning = false
          window.clearTimeout(timer)
          track.style.transition = 'none'
          for (const node of [...track.querySelectorAll('.spin-title')]) {
            if (node !== landed) node.remove()
          }
          track.style.transform = 'none'
          prompt.textContent = idea.prompt
          guide.href = idea.guide
          guide.textContent = idea.guideTitle
          copy.dataset.copy = idea.prompt
          copy.disabled = false
          run.disabled = false
          label.textContent = 'Run again'
          root.dataset.state = 'settled'
          root.dataset.idea = idea.id
          run.focus({ preventScroll: true })
        }

        const play = (idea: (typeof spinIdeas)[number]) => {
          window.clearTimeout(timer)
          spinning = true
          root.dataset.state = 'running'
          delete root.dataset.idea
          run.disabled = true
          label.textContent = 'Spinning'
          copy.disabled = true
          copy.dataset.copy = ''
          prompt.textContent = ''
          guide.textContent = ''
          guide.removeAttribute('href')

          const rows = []
          for (let i = 0; i < 20; i += 1) {
            const row = spinIdeas[i % spinIdeas.length]
            if (row) rows.push(row)
          }
          rows.push(idea)
          track.replaceChildren()
          let landed: HTMLElement | null = null
          for (let index = 0; index < rows.length; index += 1) {
            const row = rows[index]
            if (!row) continue
            const node = document.createElement('p')
            node.className = 'spin-title'
            node.textContent = row.title
            if (index === rows.length - 1) {
              node.classList.add('is-landed')
              landed = node
            }
            track.append(node)
          }
          if (!landed) return
          const winner = landed
          const rowHeight = winner.offsetHeight || 120
          const start = (reel.clientHeight - rowHeight) / 2
          const end = start - (rows.length - 1) * rowHeight
          track.style.transition = 'none'
          track.style.transform = `translate3d(0, ${start}px, 0)`
          const finish = () => settle(idea, winner)
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
            track.style.transform = `translate3d(0, ${end}px, 0)`
            finish()
            return
          }
          void track.offsetHeight
          track.style.transition = 'transform 2600ms cubic-bezier(0.12, 0.8, 0.16, 1)'
          const onEnd = (event: TransitionEvent) => {
            if (event.target !== track || event.propertyName !== 'transform') return
            track.removeEventListener('transitionend', onEnd)
            finish()
          }
          track.addEventListener('transitionend', onEnd)
          track.style.transform = `translate3d(0, ${end}px, 0)`
          timer = window.setTimeout(() => {
            track.removeEventListener('transitionend', onEnd)
            finish()
          }, 3200)
        }

        run.addEventListener('click', () => {
          if (spinning) return
          const result = nextSpin(spinIdeas, readShown(), Math.random)
          sessionStorage.setItem(key, JSON.stringify(result.shown))
          play(result.idea)
        })
      }
    }
  </script>
</ToolPage>
