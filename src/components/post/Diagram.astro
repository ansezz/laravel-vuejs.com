---
// Pre-rendered Mermaid diagram (docs/diagrams/<name>.mmd -> public/diagrams/<name>-{light,dark}.svg via `npm run diagrams`).
// alt describes the flow in words, for screen readers and for the Markdown copy of the post.
interface Props { name: string; alt: string; caption?: string; width?: number; height?: number }
const { name, alt, caption, width, height } = Astro.props
---
<figure class="diagram">
  <img class="only-light" src={`/diagrams/${name}-light.svg`} alt={alt} loading="lazy" decoding="async" width={width} height={height}>
  <img class="only-dark" src={`/diagrams/${name}-dark.svg`} alt="" aria-hidden="true" loading="lazy" decoding="async" width={width} height={height}>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
