---
import Cover from './Cover.astro'
import Icon from './Icon.astro'
import { fmtDate, type Post } from '../lib/content'
interface Props { post: Post; feature?: boolean; headingLevel?: 'h2' | 'h3'; eager?: boolean }
const { post, feature = false, headingLevel: H = 'h3', eager = false } = Astro.props
---
<article class={`card reveal ${feature ? 'card-feature' : ''}`}>
  <a class="card-link" href={post.url}>
    <Cover post={post} sizes={feature ? '(max-width: 860px) 100vw, 640px' : undefined} eager={eager} />
    <div class="card-body">
      <div class="card-cats">
        {post.categories.map(c => <span class="chip chip-brand">{c.name}</span>)}
      </div>
      <H>{post.title}</H>
      <p>{post.excerpt}</p>
      <div class="card-meta">
        <span><Icon name="calendar" size={14} /><time datetime={(post.updated ?? post.date).toISOString()}>{fmtDate(post.updated ?? post.date)}</time></span>
        <span><Icon name="clock" size={14} />{post.readingMinutes} min read</span>
        {feature && <span class="link-arrow" style="margin-left:auto">Read <Icon name="arrow" size={16} /></span>}
      </div>
    </div>
  </a>
</article>
